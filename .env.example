# DropLink Environment Configuration

# Custom WebSocket signaling endpoint (leave blank to use auto-detected host in local dev)
# Example for Cloudflare Worker: wss://droplink-signaling.your-subdomain.workers.dev/signaling
VITE_SIGNALING_URL=wss://droplink-signaling.onrender.com

# STUN Servers for NAT Traversal (JSON array of RTCIceServer)
VITE_STUN_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]'

# Optional TURN Servers for restrictive enterprise firewalls/symmetric NATs
# VITE_TURN_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]'
